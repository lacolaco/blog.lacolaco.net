{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/protect-notion-content.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/check-branch-state.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/protect-cloud-run-tags/protect-cloud-run-tags.sh"
          }
        ]
      }
    ]
  }
}
