---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import SearchDialog from './SearchDialog.astro';

type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<header
  class:list={[
    'border-b border-gray-200',
    className,
  ]}
>
  <div class="max-w-(--breakpoint-lg) mx-auto px-4 lg:px-10 flex items-center justify-between py-3 md:py-4">
    <div>
      <a
        href="/"
        class="font-title text-lg font-bold text-default no-underline hover:opacity-70"
      >
        {SITE_TITLE}
      </a>
      <span class="hidden md:inline text-[13px] text-tertiary ml-2">{SITE_DESCRIPTION}</span>
    </div>
    <div class="flex flex-row items-center justify-end gap-x-2">
      <div class="flex items-center">
        <search-toggle-button>
          <button
            class="text-default leading-0 rounded-full p-1"
            title="Search"
            aria-label="Search"
            aria-haspopup="dialog"
            aria-keyshortcuts="Control+K Meta+K"
          >
            <span class="icon-[material-symbols--search] text-[20px]"></span>
          </button>
        </search-toggle-button>
      </div>
      <div class="flex items-center">
        <a
          href="/tags/"
          class="text-default hover:text-default-muted hover:no-underline leading-0 rounded-full p-1"
          title="Tags"
        >
          <span class="icon-[mdi--tag-outline] text-[20px]"></span>
        </a>
      </div>
      <div class="flex items-center">
        <a href="https://lacolaco.net" target="_blank" rel="noopener noreferrer" title="profile">
          <img
            class="rounded-full border border-solid border-gray-400 block w-6 h-6"
            src="/icons/laco.png"
            alt="Profile"
          />
        </a>
      </div>
    </div>
  </div>
</header>

<SearchDialog />

<script>
  class SearchToggleButton extends HTMLElement {
    constructor() {
      super();
      this.querySelector('button')!.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('site-search:open'));
      });
    }
  }

  customElements.define('search-toggle-button', SearchToggleButton);
</script>
